generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  EDUCATIONAL
  PROJECT
  ACHIEVEMENT
}

enum Visibility {
  PUBLIC
  CAMPUS
  COMMUNITY
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum BookmarkItemType {
  POST
  NOTE
  PYQ
  VIDEO
  OPPORTUNITY
}

enum CommunityCategory {
  COLLEGE
  BRANCH
  SEMESTER
  INTEREST
  PROJECT
  CAREER
}

enum CommunityMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExamFrequency {
  HIGH
  MEDIUM
  LOW
}

enum OpportunityCategory {
  INTERNSHIP
  HACKATHON
  WORKSHOP
  COMPETITION
  SCHOLARSHIP
  JOB
  CAREER_EVENT
}

enum NoticeCategory {
  EXAM
  RESULT
  ADMISSION
  SCHOLARSHIP
  CAREER
  GENERAL
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MESSAGE
  COMMUNITY
  MENTORSHIP
  PROJECT
  OPPORTUNITY
  NOTICE
}

enum ReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  COPYRIGHT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ProjectStatus {
  IDEA
  LOOKING_FOR_TEAM
  IN_PROGRESS
  COMPLETED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum AIRole {
  USER
  ASSISTANT
  SYSTEM
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  passwordHash       String
  mobile             String?
  role               Role               @default(STUDENT)
  verificationStatus VerificationStatus @default(PENDING)
  avatar             String?
  bio                String?
  beuRegNo           String?            @unique // Sensitive, not returned publicly
  collegeId          String?
  branchId           String?
  semesterId         String?
  contributionPoints Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  college            College?           @relation(fields: [collegeId], references: [id])
  branch             Branch?            @relation(fields: [branchId], references: [id])
  semester           Semester?          @relation(fields: [semesterId], references: [id])
  profile            Profile?
  verifications      Verification[]
  refreshTokens      RefreshToken[]
  skills             UserSkill[]
  achievements       Achievement[]
  posts              Post[]
  comments           Comment[]
  likes              Like[]
  bookmarks          Bookmark[]
  following          Follow[]           @relation("FollowerRelation")
  followers          Follow[]           @relation("FollowingRelation")
  communityMembers   CommunityMember[]
  createdCommunities Community[]
  communityPosts     CommunityPost[]
  conversationMembers ConversationMember[]
  sentMessages       Message[]
  notifications      Notification[]
  notes              Note[]
  studyVideos        StudyVideo[]
  pyqs               PYQ[]
  createdProjects    Project[]
  projectMembers     ProjectMember[]
  mentorProfile      MentorProfile?
  mentorshipRequestsAsStudent MentorshipRequest[] @relation("StudentMentorship")
  studyPlans         StudyPlan[]
  aiConversations    AIConversation[]
  reportsFiled       Report[]           @relation("ReporterRelation")
  adminActions       AdminAction[]

  @@index([email])
  @@index([role])
  @@index([collegeId])
  @@index([branchId])
  @@index([semesterId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  github      String?
  linkedin    String?
  portfolio   String?
  interests   String[] @default([])
  careerGoals String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id          String             @id @default(uuid())
  userId      String
  collegeName String
  beuRegNo    String
  documentUrl String?
  status      VerificationStatus @default(PENDING)
  adminNote   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model College {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  location  String
  district  String
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  subjects  Subject[]
}

model Semester {
  id        String   @id @default(uuid())
  number    Int      @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  subjects  Subject[]
}

model Skill {
  id        String      @id @default(uuid())
  name      String      @unique
  category  String      @default("General")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users     UserSkill[]
}

model UserSkill {
  id          String           @id @default(uuid())
  userId      String
  skillId     String
  proficiency SkillProficiency @default(INTERMEDIATE)
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model Achievement {
  id             String   @id @default(uuid())
  userId         String
  title          String
  description    String?
  date           String?
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("FollowerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowingRelation", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id         String      @id @default(uuid())
  authorId   String
  type       PostType    @default(TEXT)
  content    String
  visibility Visibility  @default(PUBLIC)
  isPinned   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media      PostMedia[]
  comments   Comment[]
  likes      Like[]

  @@index([authorId])
  @@index([type])
  @@index([createdAt])
}

model PostMedia {
  id        String    @id @default(uuid())
  postId    String
  url       String
  type      MediaType @default(IMAGE)
  createdAt DateTime  @default(now())

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Bookmark {
  id        String           @id @default(uuid())
  userId    String
  itemType  BookmarkItemType
  itemId    String
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@index([itemType, itemId])
}

model Community {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String
  category    CommunityCategory @default(INTEREST)
  icon        String?           @default("🚀")
  coverImage  String?
  rules       String[]          @default([])
  isPrivate   Boolean           @default(false)
  creatorId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  creator     User              @relation(fields: [creatorId], references: [id])
  members     CommunityMember[]
  posts       CommunityPost[]

  @@index([category])
  @@index([slug])
}

model CommunityMember {
  id          String              @id @default(uuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  createdAt   DateTime            @default(now())

  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model CommunityPost {
  id          String    @id @default(uuid())
  communityId String
  authorId    String
  title       String
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([authorId])
}

model Conversation {
  id            String               @id @default(uuid())
  isGroup       Boolean              @default(false)
  title         String?
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Subject {
  id          String      @id @default(uuid())
  name        String
  code        String      @unique
  branchId    String
  semesterId  String
  credits     Int         @default(4)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch      Branch      @relation(fields: [branchId], references: [id])
  semester    Semester    @relation(fields: [semesterId], references: [id])
  syllabus    Syllabus?
  pyqs        PYQ[]
  notes       Note[]
  videos      StudyVideo[]
  studyTasks  StudyTask[]

  @@index([branchId])
  @@index([semesterId])
  @@index([code])
}

model Syllabus {
  id            String          @id @default(uuid())
  subjectId     String          @unique
  totalHours    Int             @default(45)
  examMarks     Int             @default(70)
  internalMarks Int             @default(30)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics        SyllabusTopic[]
}

model SyllabusTopic {
  id            String        @id @default(uuid())
  syllabusId    String
  unitNumber    Int
  unitTitle     String
  title         String
  description   String?
  hours         Int           @default(8)
  examFrequency ExamFrequency @default(HIGH)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  syllabus      Syllabus      @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@index([syllabusId])
  @@index([unitNumber])
}

model PYQ {
  id           String   @id @default(uuid())
  subjectId    String
  year         Int
  examType     String   @default("END_TERM")
  fileUrl      String
  solutionUrl  String?
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([subjectId])
  @@index([year])
}

model Note {
  id               String           @id @default(uuid())
  subjectId        String
  title            String
  description      String?
  unitNumber       Int
  fileUrl          String
  moderationStatus ModerationStatus @default(PENDING)
  uploadedById     String
  downloadsCount   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])

  @@index([subjectId])
  @@index([moderationStatus])
  @@index([uploadedById])
}

model StudyVideo {
  id               String           @id @default(uuid())
  subjectId        String
  title            String
  description      String?
  unitNumber       Int
  videoUrl         String
  thumbnailUrl     String?
  channelName      String?
  duration         String?
  moderationStatus ModerationStatus @default(APPROVED)
  uploadedById     String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])

  @@index([subjectId])
  @@index([moderationStatus])
}

model Opportunity {
  id               String              @id @default(uuid())
  title            String
  description      String
  category         OpportunityCategory @default(INTERNSHIP)
  organization     String
  location         String              @default("Remote")
  isOnline         Boolean             @default(true)
  stipendOrPrize   String?
  deadline         String
  source           String              // Backward compatible alias for sourceName
  sourceName       String              @default("Official Source")
  sourceUrl        String
  applicationUrl   String?
  publishedDate    String?
  lastVerified     String?
  isOfficialSource Boolean             @default(true)
  sourcesJson      String?             // JSON string for secondary/multiple original sources
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([category])
  @@index([isOfficialSource])
}

model Notice {
  id               String         @id @default(uuid())
  title            String
  category         NoticeCategory @default(EXAM)
  isOfficial       Boolean        @default(true)
  source           String         // Backward compatible alias for sourceName
  sourceName       String         @default("Examination Controller, BEU")
  sourceUrl        String?
  applicationUrl   String?
  summary          String
  content          String
  isUrgent         Boolean        @default(false)
  fileUrl          String?
  publishedAt      String
  publishedDate    String?
  deadline         String?
  lastVerified     String?
  isOfficialSource Boolean        @default(true)
  sourcesJson      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([category])
  @@index([isOfficial])
  @@index([isOfficialSource])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       ReportReason @default(OTHER)
  details      String?
  status       ReportStatus @default(OPEN)
  adminNote    String?
  resolvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter     User         @relation("ReporterRelation", fields: [reporterId], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  actionType String
  targetType String
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}

model StudyPlan {
  id                 String      @id @default(uuid())
  userId             String
  title              String
  examDate           String
  availableHoursDaily Int        @default(4)
  prepLevel          String      @default("intermediate")
  status             String      @default("ACTIVE")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks              StudyTask[]

  @@index([userId])
}

model StudyTask {
  id             String    @id @default(uuid())
  studyPlanId    String
  subjectId      String?
  title          String
  dueDate        String
  estimatedHours Float     @default(2.0)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  studyPlan      StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subject        Subject?  @relation(fields: [subjectId], references: [id])

  @@index([studyPlanId])
  @@index([isCompleted])
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String      @default("New Academic Discussion")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           AIRole         @default(USER)
  content        String
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Project {
  id             String          @id @default(uuid())
  creatorId      String
  title          String
  description    String
  category       String
  requiredSkills String[]        @default([])
  teamSize       Int             @default(4)
  status         ProjectStatus   @default(LOOKING_FOR_TEAM)
  githubUrl      String?
  demoUrl        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          ProjectTask[]

  @@index([creatorId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("Member")
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectTask {
  id           String            @id @default(uuid())
  projectId    String
  title        String
  assignedToId String?
  status       ProjectTaskStatus @default(TODO)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model MentorProfile {
  id             String              @id @default(uuid())
  userId         String              @unique
  bio            String
  skills         String[]            @default([])
  domain         String
  yearOfStudy    String              @default("4th Year")
  rating         Float               @default(5.0)
  reviewsCount   Int                 @default(0)
  availableSlots Int                 @default(5)
  isAvailable    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       MentorshipRequest[] @relation("MentorRequests")

  @@index([domain])
  @@index([isAvailable])
}

model MentorshipRequest {
  id          String           @id @default(uuid())
  mentorId    String
  studentId   String
  topic       String
  message     String
  status      MentorshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  mentor      MentorProfile    @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  student     User             @relation("StudentMentorship", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([studentId])
  @@index([status])
}

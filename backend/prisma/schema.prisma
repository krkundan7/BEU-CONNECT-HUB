// NOV-COMMENT-49: Five-Tier Academic Hierarchy & Relational Integrity Schema
// Defines the canonical database schema for Bihar Engineering University Connect Hub.
// Models the 5-tier academic hierarchy: Branch -> Semester -> Subject -> SubjectUnit -> Topic -> SubTopic.
// Enforces relational foreign keys, cascade deletes, composite unique indexes (e.g. subjectId_unitNumber, userId_topicId),
// and indexed lookups on student credentials, refresh tokens, solved PYQs, and handwritten study notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  EDUCATIONAL
  PROJECT
  ACHIEVEMENT
}

enum Visibility {
  PUBLIC
  CAMPUS
  COMMUNITY
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum BookmarkItemType {
  POST
  NOTE
  PYQ
  VIDEO
  OPPORTUNITY
}

enum CommunityCategory {
  COLLEGE
  BRANCH
  SEMESTER
  INTEREST
  PROJECT
  CAREER
}

enum CommunityMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExamFrequency {
  HIGH
  MEDIUM
  LOW
}

enum OpportunityCategory {
  INTERNSHIP
  HACKATHON
  WORKSHOP
  COMPETITION
  SCHOLARSHIP
  JOB
  CAREER_EVENT
}

enum NoticeCategory {
  EXAM
  RESULT
  ADMIT_CARD
  TIME_TABLE
  REGISTRATION
  ACADEMIC
  HOLIDAY
  SCHOLARSHIP
  INTERNSHIP
  PLACEMENT
  ADMISSION
  NOTICE
  CIRCULAR
  ANNOUNCEMENT
  CAREER
  GENERAL
  OTHER
}

enum NoticeVerificationStatus {
  FETCHED
  UNVERIFIED
  VERIFIED
  PUBLISHED
  UPDATED
  ARCHIVED
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MESSAGE
  COMMUNITY
  MENTORSHIP
  PROJECT
  OPPORTUNITY
  NOTICE
}

enum ReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  COPYRIGHT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ProjectStatus {
  IDEA
  LOOKING_FOR_TEAM
  IN_PROGRESS
  COMPLETED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum AIRole {
  USER
  ASSISTANT
  SYSTEM
}

enum BranchCategory {
  CORE
  EMERGING_TECH
  INTERDISCIPLINARY
}

enum SubjectType {
  THEORY
  PRACTICAL
  TUTORIAL
  DESIGN
  PROJECT
  MANDATORY
}

enum SubjectCategory {
  PCC
  BSC
  ESC
  HSMC
  PEC
  OEC
  PROJ
  MC
}

enum SyllabusStatus {
  ACTIVE
  ARCHIVED
  REVISED
  NEEDS_REVIEW
  DRAFT
}

enum TopicProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REVISION_REQUIRED
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  passwordHash       String
  mobile             String?
  role               Role               @default(STUDENT)
  verificationStatus VerificationStatus @default(PENDING)
  avatar             String?
  bio                String?
  beuRegNo           String?            @unique // Sensitive, not returned publicly
  collegeId          String?
  branchId           String?
  semesterId         String?
  contributionPoints Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  college            College?           @relation(fields: [collegeId], references: [id])
  branch             Branch?            @relation(fields: [branchId], references: [id])
  semester           Semester?          @relation(fields: [semesterId], references: [id])
  profile            Profile?
  verifications      Verification[]
  refreshTokens      RefreshToken[]
  skills             UserSkill[]
  achievements       Achievement[]
  posts              Post[]
  comments           Comment[]
  likes              Like[]
  bookmarks          Bookmark[]
  following          Follow[]           @relation("FollowerRelation")
  followers          Follow[]           @relation("FollowingRelation")
  communityMembers   CommunityMember[]
  createdCommunities Community[]
  communityPosts     CommunityPost[]
  conversationMembers ConversationMember[]
  sentMessages       Message[]
  notifications      Notification[]
  notes              Note[]
  studyVideos        StudyVideo[]
  pyqs               PYQ[]
  createdProjects    Project[]
  projectMembers     ProjectMember[]
  mentorProfile      MentorProfile?
  mentorshipRequestsAsStudent MentorshipRequest[] @relation("StudentMentorship")
  studyPlans         StudyPlan[]
  aiConversations    AIConversation[]
  topicProgress      TopicProgress[]
  reportsFiled       Report[]           @relation("ReporterRelation")
  adminActions       AdminAction[]
  noticeReadStates   NoticeReadState[]

  @@index([email])
  @@index([role])
  @@index([collegeId])
  @@index([branchId])
  @@index([semesterId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  github      String?
  linkedin    String?
  portfolio   String?
  interests   String[] @default([])
  careerGoals String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id          String             @id @default(uuid())
  userId      String
  collegeName String
  beuRegNo    String
  documentUrl String?
  status      VerificationStatus @default(PENDING)
  adminNote   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model College {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  location  String
  district  String
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

model AcademicSession {
  id        String     @id @default(uuid())
  name      String     @unique // e.g. "2026-2027", "2025-2026", "2024-2025"
  isActive  Boolean    @default(true)
  syllabi   Syllabus[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([name])
}

model RegulationVersion {
  id                  String         @id @default(uuid())
  code                String         @unique // e.g. "REG_2026", "REG_2018"
  name                String         // "BEU UG Regulation 2026", "BEU AICTE Model Curriculum 2018-2025"
  effectiveFromYear   Int            // 2026, 2018
  officialDocumentUrl String?        @default("https://beu-bih.ac.in/backend/1778027052729-UG%20Regulation_05.04.2026.pdf")
  description         String?
  status              SyllabusStatus @default(ACTIVE)
  syllabi             Syllabus[]
  subjects            Subject[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([code])
}

model Branch {
  id                  String         @id @default(uuid())
  name                String
  code                String         @unique
  category            BranchCategory @default(CORE)
  officialCode        String?
  hasOfficialSyllabus Boolean        @default(true)
  syllabusStatus      String         @default("AVAILABLE")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  users               User[]
  subjects            Subject[]
  syllabi             Syllabus[]
  noticeBranches      NoticeBranch[]

  @@index([code])
  @@index([category])
}

model Semester {
  id        String     @id @default(uuid())
  number    Int        @unique
  name      String
  group     String?    @default("Common")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users     User[]
  subjects  Subject[]
  syllabi   Syllabus[]
  noticeSemesters NoticeSemester[]

  @@index([number])
}

model Skill {
  id        String      @id @default(uuid())
  name      String      @unique
  category  String      @default("General")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users     UserSkill[]
}

model UserSkill {
  id          String           @id @default(uuid())
  userId      String
  skillId     String
  proficiency SkillProficiency @default(INTERMEDIATE)
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model Achievement {
  id             String   @id @default(uuid())
  userId         String
  title          String
  description    String?
  date           String?
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("FollowerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowingRelation", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id         String      @id @default(uuid())
  authorId   String
  type       PostType    @default(TEXT)
  content    String
  visibility Visibility  @default(PUBLIC)
  isPinned   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media      PostMedia[]
  comments   Comment[]
  likes      Like[]

  @@index([authorId])
  @@index([type])
  @@index([createdAt])
}

model PostMedia {
  id        String    @id @default(uuid())
  postId    String
  url       String
  type      MediaType @default(IMAGE)
  createdAt DateTime  @default(now())

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Bookmark {
  id        String           @id @default(uuid())
  userId    String
  itemType  BookmarkItemType
  itemId    String
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@index([itemType, itemId])
}

model Community {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String
  category    CommunityCategory @default(INTEREST)
  icon        String?           @default("🚀")
  coverImage  String?
  rules       String[]          @default([])
  isPrivate   Boolean           @default(false)
  creatorId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  creator     User              @relation(fields: [creatorId], references: [id])
  members     CommunityMember[]
  posts       CommunityPost[]

  @@index([category])
  @@index([slug])
}

model CommunityMember {
  id          String              @id @default(uuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  createdAt   DateTime            @default(now())

  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model CommunityPost {
  id          String    @id @default(uuid())
  communityId String
  authorId    String
  title       String
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([authorId])
}

model Conversation {
  id            String               @id @default(uuid())
  isGroup       Boolean              @default(false)
  title         String?
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Subject {
  id               String             @id @default(uuid())
  name             String
  code             String             @unique
  shortName        String?
  branchId         String
  semesterId       String
  regulationId     String?
  type             SubjectType        @default(THEORY)
  category         SubjectCategory    @default(PCC)
  credits          Float              @default(4.0)
  ltp              String             @default("3-1-0")
  lectureHours     Int                @default(3)
  tutorialHours    Int                @default(1)
  practicalHours   Int                @default(0)
  internalMarks    Int                @default(30)
  endSemMarks      Int                @default(70)
  totalMarks       Int                @default(100)
  description      String?
  prerequisites    String?
  sourceUrl        String             @default("https://beu-bih.ac.in/academics/Syllabus/B.Tech")
  isOfficialSource Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  branch           Branch             @relation(fields: [branchId], references: [id])
  semester         Semester           @relation(fields: [semesterId], references: [id])
  regulation       RegulationVersion? @relation(fields: [regulationId], references: [id])
  syllabus         Syllabus?
  units            SubjectUnit[]
  pyqs             PYQ[]
  notes            Note[]
  videos           StudyVideo[]
  studyTasks       StudyTask[]

  @@index([branchId])
  @@index([semesterId])
  @@index([regulationId])
  @@index([code])
}

model Syllabus {
  id                 String             @id @default(uuid())
  subjectId          String?            @unique
  branchId           String?
  semesterId         String?
  regulationId       String?
  academicSessionId  String?
  versionNumber      String             @default("1.0")
  status             SyllabusStatus     @default(ACTIVE)
  source             String             @default("BEU Official Portal")
  sourceUrl          String             @default("https://beu-bih.ac.in/academics/Syllabus/B.Tech")
  sourceDocumentName String?            @default("BEU_BTech_Syllabus.pdf")
  isOfficialSource   Boolean            @default(true)
  lastVerifiedAt     DateTime           @default(now())
  totalCredits       Float              @default(20.0)
  totalHours         Int                @default(45)
  examMarks          Int                @default(70)
  internalMarks      Int                @default(30)
  publishedAt        DateTime?
  approvedBy         String?
  adminNotes         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  subject            Subject?           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  branch             Branch?            @relation(fields: [branchId], references: [id])
  semester           Semester?          @relation(fields: [semesterId], references: [id])
  regulation         RegulationVersion? @relation(fields: [regulationId], references: [id])
  academicSession    AcademicSession?   @relation(fields: [academicSessionId], references: [id])
  topics             SyllabusTopic[]

  @@index([branchId, semesterId])
  @@index([regulationId])
  @@index([status])
}

model SyllabusTopic {
  id            String        @id @default(uuid())
  syllabusId    String
  unitNumber    Int
  unitTitle     String
  title         String
  description   String?
  hours         Int           @default(8)
  examFrequency ExamFrequency @default(HIGH)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  syllabus      Syllabus      @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@index([syllabusId])
  @@index([unitNumber])
}

model SubjectUnit {
  id            String         @id @default(uuid())
  subjectId     String
  unitNumber    Int
  unitTitle     String
  hours         Int            @default(8)
  description   String?
  examFrequency ExamFrequency  @default(HIGH)
  sourceUrl     String?        @default("https://beu-bih.ac.in/academics/Syllabus/B.Tech")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics        Topic[]
  pyqs          PYQ[]
  notes         Note[]

  @@unique([subjectId, unitNumber])
  @@index([subjectId])
}

model Topic {
  id               String          @id @default(uuid())
  unitId           String
  orderIndex       Int             @default(0)
  title            String
  description      String?
  hours            Float?          @default(2.0)
  isCore           Boolean         @default(true)
  learningOutcomes String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  unit             SubjectUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subTopics        SubTopic[]
  progress         TopicProgress[]
  pyqs             PYQ[]
  notes            Note[]

  @@index([unitId])
}

model SubTopic {
  id             String   @id @default(uuid())
  topicId        String
  orderIndex     Int      @default(0)
  title          String
  contentSummary String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic          Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model TopicProgress {
  id                 String              @id @default(uuid())
  userId             String
  topicId            String
  status             TopicProgressStatus @default(NOT_STARTED)
  progressPercentage Int                 @default(0)
  notes              String?
  lastStudiedAt      DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@index([status])
}

model PYQ {
  id           String       @id @default(uuid())
  subjectId    String
  unitId       String?
  topicId      String?
  year         Int
  examType     String       @default("END_TERM")
  marks        Int?         @default(7)
  difficulty   String?      @default("MEDIUM")
  questionText String?
  solutionText String?
  fileUrl      String
  solutionUrl  String?
  isVerified   Boolean      @default(true)
  uploadedById String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit         SubjectUnit? @relation(fields: [unitId], references: [id])
  topic        Topic?       @relation(fields: [topicId], references: [id])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([subjectId])
  @@index([unitId])
  @@index([topicId])
  @@index([year])
}

model Note {
  id               String           @id @default(uuid())
  subjectId        String
  unitId           String?
  topicId          String?
  title            String
  description      String?
  unitNumber       Int
  fileUrl          String
  moderationStatus ModerationStatus @default(PENDING)
  uploadedById     String
  downloadsCount   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit             SubjectUnit?     @relation(fields: [unitId], references: [id])
  topic            Topic?           @relation(fields: [topicId], references: [id])
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])

  @@index([subjectId])
  @@index([unitId])
  @@index([topicId])
  @@index([moderationStatus])
  @@index([uploadedById])
}

model StudyVideo {
  id               String           @id @default(uuid())
  subjectId        String
  title            String
  description      String?
  unitNumber       Int
  videoUrl         String
  thumbnailUrl     String?
  channelName      String?
  duration         String?
  moderationStatus ModerationStatus @default(APPROVED)
  uploadedById     String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])

  @@index([subjectId])
  @@index([moderationStatus])
}

model Opportunity {
  id               String              @id @default(uuid())
  title            String
  description      String
  category         OpportunityCategory @default(INTERNSHIP)
  organization     String
  location         String              @default("Remote")
  isOnline         Boolean             @default(true)
  stipendOrPrize   String?
  deadline         String
  source           String              // Backward compatible alias for sourceName
  sourceName       String              @default("Official Source")
  sourceUrl        String
  applicationUrl   String?
  publishedDate    String?
  lastVerified     String?
  isOfficialSource Boolean             @default(true)
  sourcesJson      String?             // JSON string for secondary/multiple original sources
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([category])
  @@index([isOfficialSource])
}

model Notice {
  id                 String                   @id @default(uuid())
  title              String
  notificationNumber String?
  category           NoticeCategory           @default(EXAM)
  isOfficial         Boolean                  @default(true)
  source             String                   // Backward compatible alias for sourceName
  sourceName         String                   @default("Examination Controller, BEU")
  sourceUrl          String?
  applicationUrl     String?
  documentUrl        String?                  // Direct official PDF document link
  summary            String
  content            String
  isUrgent           Boolean                  @default(false)
  isImportant        Boolean                  @default(false)
  isAllBranches      Boolean                  @default(true)
  isAllSemesters     Boolean                  @default(true)
  fileUrl            String?
  publishedAt        String
  publishedDate      String?
  deadline           String?
  lastVerified       String?
  isOfficialSource   Boolean                  @default(true)
  verificationStatus NoticeVerificationStatus @default(VERIFIED)
  contentHash        String?                  @unique
  sourcesJson        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  targetBranches     NoticeBranch[]
  targetSemesters    NoticeSemester[]
  readStates         NoticeReadState[]

  @@index([category])
  @@index([verificationStatus])
  @@index([isOfficial])
  @@index([isOfficialSource])
  @@index([isUrgent])
  @@index([isImportant])
  @@index([contentHash])
}

model NoticeBranch {
  id         String   @id @default(uuid())
  noticeId   String
  branchId   String?
  branchCode String  // e.g. "CSE", "ECE", "ME", "CE"
  createdAt  DateTime @default(now())

  notice     Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  branch     Branch?  @relation(fields: [branchId], references: [id])

  @@unique([noticeId, branchCode])
  @@index([noticeId])
  @@index([branchCode])
  @@index([branchId])
}

model NoticeSemester {
  id             String    @id @default(uuid())
  noticeId       String
  semesterId     String?
  semesterNumber Int       // 1 to 8
  createdAt      DateTime  @default(now())

  notice         Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  semester       Semester? @relation(fields: [semesterId], references: [id])

  @@unique([noticeId, semesterNumber])
  @@index([noticeId])
  @@index([semesterNumber])
  @@index([semesterId])
}

model NoticeReadState {
  id        String   @id @default(uuid())
  noticeId  String
  userId    String
  readAt    DateTime @default(now())

  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@index([userId])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       ReportReason @default(OTHER)
  details      String?
  status       ReportStatus @default(OPEN)
  adminNote    String?
  resolvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter     User         @relation("ReporterRelation", fields: [reporterId], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  actionType String
  targetType String
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}

model StudyPlan {
  id                 String      @id @default(uuid())
  userId             String
  title              String
  examDate           String
  availableHoursDaily Int        @default(4)
  prepLevel          String      @default("intermediate")
  status             String      @default("ACTIVE")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks              StudyTask[]

  @@index([userId])
}

model StudyTask {
  id             String    @id @default(uuid())
  studyPlanId    String
  subjectId      String?
  title          String
  dueDate        String
  estimatedHours Float     @default(2.0)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  studyPlan      StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subject        Subject?  @relation(fields: [subjectId], references: [id])

  @@index([studyPlanId])
  @@index([isCompleted])
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String      @default("New Academic Discussion")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           AIRole         @default(USER)
  content        String
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Project {
  id             String          @id @default(uuid())
  creatorId      String
  title          String
  description    String
  category       String
  requiredSkills String[]        @default([])
  teamSize       Int             @default(4)
  status         ProjectStatus   @default(LOOKING_FOR_TEAM)
  githubUrl      String?
  demoUrl        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          ProjectTask[]

  @@index([creatorId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("Member")
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectTask {
  id           String            @id @default(uuid())
  projectId    String
  title        String
  assignedToId String?
  status       ProjectTaskStatus @default(TODO)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model MentorProfile {
  id             String              @id @default(uuid())
  userId         String              @unique
  bio            String
  skills         String[]            @default([])
  domain         String
  yearOfStudy    String              @default("4th Year")
  rating         Float               @default(5.0)
  reviewsCount   Int                 @default(0)
  availableSlots Int                 @default(5)
  isAvailable    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       MentorshipRequest[] @relation("MentorRequests")

  @@index([domain])
  @@index([isAvailable])
}

model MentorshipRequest {
  id          String           @id @default(uuid())
  mentorId    String
  studentId   String
  topic       String
  message     String
  status      MentorshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  mentor      MentorProfile    @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  student     User             @relation("StudentMentorship", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([studentId])
  @@index([status])
}

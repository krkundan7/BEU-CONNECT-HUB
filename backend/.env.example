# ==========================================
# BEU CONNECT HUB - BACKEND ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Client CORS URLs (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beu_connect_hub?schema=public

# JWT Secrets (Use strong 256-bit cryptographically secure strings in production)
JWT_SECRET=super_secret_jwt_access_key_beu_hub_development_2025
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_beu_hub_development_2025
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Provider Integration (Google Gemini / OpenAI compatible)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# Storage Configuration
# Options: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Optional S3 Cloud Storage Settings
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=beu-connect-hub-storage
